{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wizardry.example/parity/test-environment.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "platform_id", "hardware", "architecture", "operating_system", "release", "access", "access_mode"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "platform_id": {"type": "string", "minLength": 1},
    "hardware": {"type": "string", "minLength": 1},
    "architecture": {"type": "string", "minLength": 1},
    "operating_system": {"type": "string", "minLength": 1},
    "release": {"type": "string", "minLength": 1},
    "access": {"type": "string", "minLength": 1},
    "access_mode": {"enum": ["read_only", "read_write", "manual"]}
  }
}
