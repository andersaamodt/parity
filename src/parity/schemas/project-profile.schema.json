{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wizardry.example/parity/project-profile.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project", "capabilities", "platforms"],
  "properties": {
    "schema_version": {"const": 1},
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1}
      }
    },
    "arche": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "digest"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "outcome", "installation", "executor", "platforms"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "outcome": {"type": "string", "minLength": 1},
          "discovery": {"type": "string"},
          "installation": {"type": "string", "minLength": 1},
          "executor": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
          "platforms": {"type": "array", "items": {"type": "string"}},
          "control_target_platforms": {"type": "array", "items": {"type": "string"}},
          "authorization_scopes": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "platforms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "supported", "transports", "prerequisites"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "supported": {"type": "boolean"},
          "status": {"type": "string"},
          "transports": {"type": "array", "items": {"enum": ["local", "lan", "tor", "official_debug"]}},
          "prerequisites": {"type": "array"}
        }
      }
    }
  }
}
