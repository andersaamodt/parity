{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wizardry.example/parity/audit-evidence.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "capability_id", "platform_id", "recorded_at", "evidence_kind",
    "evidence_refs", "missing_prerequisites", "discoverable", "installed",
    "executable", "outcome_passed", "derived_status", "status_reason", "notes"
  ],
  "properties": {
    "capability_id": {"type": "string", "minLength": 1},
    "platform_id": {"type": "string", "minLength": 1},
    "recorded_at": {"type": "string", "format": "date-time"},
    "evidence_kind": {"enum": ["automated_on_platform", "manual_on_device", "source_assertion", "simulated"]},
    "evidence_refs": {"type": "array", "items": {"type": "string"}},
    "missing_prerequisites": {"type": "array", "items": {"type": "string"}},
    "discoverable": {"type": "boolean"},
    "installed": {"type": "boolean"},
    "executable": {"type": "boolean"},
    "outcome_passed": {"type": "boolean"},
    "derived_status": {"enum": ["green", "yellow", "red"]},
    "status_reason": {"type": "string"},
    "notes": {"type": "string"}
  }
}
