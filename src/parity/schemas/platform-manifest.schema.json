{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wizardry.example/parity/platform-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "platforms"],
  "properties": {
    "schema_version": {"const": 1},
    "platforms": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "wizardry_host", "role", "official_status", "transports", "prerequisites"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "wizardry_host": {"type": "boolean"},
          "role": {"type": "string", "minLength": 1},
          "official_status": {"type": "string", "minLength": 1},
          "platform_family": {"type": "string", "minLength": 1},
          "derived_from": {"type": "string", "minLength": 1},
          "target_architectures": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "hardware_family": {"type": "string", "minLength": 1},
          "transports": {"type": "array", "items": {"enum": ["local", "lan", "tor", "official_debug"]}, "uniqueItems": true},
          "prerequisites": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "kind", "applies_to", "description"],
              "properties": {
                "id": {"type": "string", "minLength": 1},
                "kind": {"enum": ["manual_gate"]},
                "applies_to": {"type": "array", "items": {"type": "string"}},
                "description": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    }
  }
}
